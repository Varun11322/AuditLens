# Environment: development | production | test
APP_ENV=development

# API / Frontend configuration
API_BASE_URL=http://localhost:8000
MAX_UPLOAD_MB=25

# Database configuration (PostgreSQL)
DATABASE_URL=postgresql+psycopg://auditlens:auditlens_password@localhost:5432/auditlens

# JWT Authentication
JWT_SECRET=replace_with_a_secure_random_secret_at_least_32_chars
JWT_EXPIRE_MINUTES=60

# Initial Admin / Seed Account
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change_this_admin_password
